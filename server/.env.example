# LearnTube AI Backend Environment Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5174

# Google Gemini API Key (Optional: for live generative AI tutoring & quiz generation)
# If omitted, LearnTube AI utilizes its built-in Smart Educational AI Engine with zero downtime
GEMINI_API_KEY=

# YouTube Data API v3 Key (Optional: for live search across videos, channels & playlists)
# If omitted, LearnTube AI seamlessly serves its curated university catalog & syllabus engine
YOUTUBE_API_KEY=

# Data Persistence Directory
DATA_DIR=./data
